{
  "name": "openhasp-editor",
  "displayName": "openHASP Page Editor",
  "description": "Visual drag-and-drop editor for creating and editing openHASP pages",
  "version": "0.1.1",
  "publisher": "PrasenPalvankar",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/prasen12/openhasp-editor.git"
  },
  "bugs": {
    "url": "https://github.com/prasen12/openhasp-editor/issues"
  },
  "homepage": "https://github.com/prasen12/openhasp-editor#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "openhasp",
    "hasp",
    "lvgl",
    "iot",
    "gui",
    "editor"
  ],
  "activationEvents": [
    "onLanguage:jsonl"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openhasp-explorer",
          "title": "openHASP",
          "icon": "images/activity-bar.svg"
        }
      ]
    },
    "views": {
      "openhasp-explorer": [
        {
          "id": "openhasp.filesView",
          "name": "Design Files",
          "icon": "images/activity-bar.svg"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "openhasp.pageEditor",
        "displayName": "openHASP Page Editor",
        "selector": [
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "*.hasp"
          },
          {
            "filenamePattern": "*.hasp.json"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "openhasp.openEditor",
        "title": "Open with openHASP Editor",
        "category": "openHASP"
      },
      {
        "command": "openhasp.uploadToDevice",
        "title": "Upload to Device",
        "category": "openHASP",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "openhasp.exportPages",
        "title": "Export Pages",
        "category": "openHASP"
      },
      {
        "command": "openhasp.exportJsonl",
        "title": "Export as JSONL",
        "category": "openHASP",
        "icon": "$(export)"
      },
      {
        "command": "openhasp.importJsonl",
        "title": "Import JSONL as Design File",
        "category": "openHASP",
        "icon": "$(combine)"
      },
      {
        "command": "openhasp.importTemplate",
        "title": "Import Template",
        "category": "openHASP"
      },
      {
        "command": "openhasp.saveAsTemplate",
        "title": "Save as Template",
        "category": "openHASP"
      },
      {
        "command": "openhasp.newDesign",
        "title": "New Design File",
        "category": "openHASP",
        "icon": "$(new-file)"
      },
      {
        "command": "openhasp.refreshFilesView",
        "title": "Refresh",
        "category": "openHASP",
        "icon": "$(refresh)"
      },
      {
        "command": "openhasp.navigateToWidget",
        "title": "Navigate to Widget",
        "category": "openHASP"
      },
      {
        "command": "openhasp.generateHAConfig",
        "title": "Generate Home Assistant Config",
        "category": "openHASP",
        "icon": "$(gear)"
      },
      {
        "command": "openhasp.connectHomeAssistant",
        "title": "Connect to Home Assistant",
        "category": "openHASP",
        "icon": "$(home)"
      },
      {
        "command": "openhasp.showLog",
        "title": "Show Log",
        "category": "openHASP",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "openhasp.newDesign",
          "when": "view == openhasp.filesView",
          "group": "navigation"
        },
        {
          "command": "openhasp.importJsonl",
          "when": "view == openhasp.filesView",
          "group": "navigation"
        },
        {
          "command": "openhasp.refreshFilesView",
          "when": "view == openhasp.filesView",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "when": "resourceExtname == .jsonl || resourceExtname == .hasp",
          "command": "openhasp.uploadToDevice",
          "group": "navigation"
        },
        {
          "when": "resourceFilename =~ /\\.hasp\\.json$/",
          "command": "openhasp.exportJsonl",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "openhasp.uploadToDevice",
          "when": "view == openhasp.filesView && viewItem == file",
          "group": "inline@1"
        },
        {
          "command": "openhasp.exportJsonl",
          "when": "view == openhasp.filesView && viewItem == file",
          "group": "inline@2"
        },
        {
          "command": "openhasp.generateHAConfig",
          "when": "view == openhasp.filesView && viewItem == file",
          "group": "inline@3"
        }
      ],
      "commandPalette": [
        {
          "command": "openhasp.navigateToWidget",
          "when": "false"
        },
        {
          "command": "openhasp.generateHAConfig",
          "when": "resourceFilename =~ /\\.hasp\\.json$/"
        },
        {
          "command": "openhasp.uploadToDevice",
          "when": "resourceExtname == .hasp.json"
        },
        {
          "command": "openhasp.exportPages",
          "when": "resourceExtname == .hasp.json"
        },
        {
          "command": "openhasp.exportJsonl",
          "when": "resourceExtname == .hasp.json"
        },
        {
          "command": "openhasp.connectHomeAssistant"
        },
        {
          "command": "openhasp.showLog"
        }
      ]
    },
    "configuration": {
      "title": "openHASP",
      "properties": {
        "openhasp.editor.canvasWidth": {
          "type": "number",
          "default": 720,
          "description": "Canvas width in pixels (display horizontal resolution)"
        },
        "openhasp.editor.canvasHeight": {
          "type": "number",
          "default": 480,
          "description": "Canvas height in pixels (display vertical resolution)"
        },
        "openhasp.editor.gridSize": {
          "type": "number",
          "default": 10,
          "description": "Grid size for snap-to-grid (in pixels)"
        },
        "openhasp.editor.snapToGrid": {
          "type": "boolean",
          "default": true,
          "description": "Enable snap-to-grid when dragging widgets"
        },
        "openhasp.editor.iconFont": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a WOFF2/WOFF/TTF font file whose glyphs match the icon codepoints used in your openHASP device firmware. The font is loaded into the canvas preview so that \\uXXXX icon values in widget text render correctly. Example: /path/to/hasp_10_icons.woff2"
        },
        "openhasp.editor.imagesRoot": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a local folder that mirrors the root of your openHASP device's LittleFS storage. Image widget \"src\" values such as \"L:/image.png\" or \"L:/image.bin\" are resolved against this folder so the canvas preview can render the actual image. LVGL \".bin\" images (true color, true color with alpha, true color chroma-keyed, indexed 8-bit, and alpha 8-bit) are decoded and rendered directly. Example: /path/to/device-littlefs"
        },
        "openhasp.templates": {
          "type": "array",
          "default": [],
          "description": "Custom widget templates"
        },
        "openhasp.mqtt.host": {
          "type": "string",
          "default": "localhost",
          "description": "MQTT broker hostname or IP address"
        },
        "openhasp.mqtt.port": {
          "type": "number",
          "default": 1883,
          "description": "MQTT broker port"
        },
        "openhasp.mqtt.username": {
          "type": "string",
          "default": "",
          "description": "MQTT broker username (leave blank if not required)"
        },
        "openhasp.mqtt.password": {
          "type": "string",
          "default": "",
          "description": "MQTT broker password (leave blank if not required)"
        },
        "openhasp.homeAssistant.url": {
          "type": "string",
          "default": "",
          "description": "Base URL of your Home Assistant instance, e.g. http://homeassistant.local:8123. Used to look up entities for widget bindings. The access token is entered separately via the \"openHASP: Connect to Home Assistant\" command and stored securely, not in settings."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run icon && npm run package",
    "icon": "node scripts/make-icon.js",
    "compile": "webpack --devtool source-map",
    "watch": "webpack --watch",
    "package": "webpack --mode production",
    "build:vsix": "node scripts/build-vsix.js",
    "publish:vsix": "node scripts/build-vsix.js && vsce publish --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^5.53.0",
    "@typescript-eslint/parser": "^5.53.0",
    "@vscode/test-electron": "^2.2.3",
    "@vscode/vsce": "^3.2.0",
    "css-loader": "^6.7.3",
    "eslint": "^8.34.0",
    "font-awesome": "^4.7.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "sharp": "^0.33.5",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.4.2",
    "typescript": "^4.9.5",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.0.8",
    "@dnd-kit/sortable": "^7.0.2",
    "@dnd-kit/utilities": "^3.2.1",
    "mqtt": "^5.15.0",
    "re-resizable": "^6.9.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.3.6"
  }
}
