# Internal docs and scratch files. CHANGELOG/LICENSE are shipped; the readme that ships is
# docs/EXTENSION_README.md, injected by `vsce package --readme-path` (see scripts/build-vsix.js),
# so the repo's contributor-facing README.md is excluded here.
README.md
docs/**
DEVELOPMENT.md
STATUS.md
FIXES.md
PHASE2-COMPLETE.md
TROUBLESHOOTING.md
RELEASING.md
t.md
enhancements.md
new-requirements.md
examples/**
Screenshot*

# Ship the bundles and assets
!dist/**/*.js
!dist/**/*.LICENSE.txt
!assets/**
!images/**
